# Copiar este archivo como .env y completar. El .env NO se sube a git.
TRAXION_URL=https://testing.telerecargas.com.ar/
TRAXION_USER=
TRAXION_PASS=

# Usuario a buscar en GESTORES -> Cuentas -> Usuario
USUARIO_BUSQUEDA=cib7kb9v3scb2sltq6yx6cf17
# Lista separada por comas (opcional; si esta vacia se usa USUARIO_BUSQUEDA)
USUARIOS=
MONTO_CREDITO=1

# false = se ve el navegador (recomendado mientras probamos)
HEADLESS=false
# false = llega hasta cargar el monto pero NO guarda (modo prueba)
GUARDAR=false
# Tope de seguridad (no es espera fija): solo corta si el servidor no responde nunca
TIMEOUT_MS=60000
# Si la busqueda de un usuario queda en 'loading' mas que esto, se registra y se sigue
TIMEOUT_BUSQUEDA_MS=3000
# Al final del lote, reintentar una vez los que dieron TIMEOUT_BUSQUEDA
REINTENTAR_TIMEOUTS=true

# Base PostgreSQL con la tabla bot.usuarios_traxion (ver sql/). Si DB_NAME queda vacio,
# el bot toma los usuarios de --usuario / --archivo / USUARIOS.
# Si el nombre de la base tiene espacios, va entre comillas: DB_NAME="Pago24 Red"
DB_HOST=localhost
DB_PORT=5432
DB_NAME="Pago24 Red"
DB_USER=postres
DB_PASS=
# Reintentos (en corridas sucesivas) de las cuentas que dieron ERROR o TIMEOUT_BUSQUEDA
MAX_INTENTOS=3
# Sincronizacion incremental: margen hacia atras (minutos) por transacciones que confirman tarde
SYNC_MARGEN_MIN=60

# Servidor Boss/Worker (python servidor.py). Otro sistema despierta al Worker con POST /despertar.
# API_HOST=0.0.0.0 para aceptar llamadas desde otras maquinas (127.0.0.1 = solo esta maquina)
API_HOST=127.0.0.1
API_PORT=8080
# Obligatorio, minimo 16 caracteres. Va en el header X-Token. Generar uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
