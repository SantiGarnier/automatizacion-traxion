# Copiar este archivo como .env y completar. El .env NO se sube a git.
TRAXION_URL=https://testing.telerecargas.com.ar/
TRAXION_USER=
TRAXION_PASS=

# Usuario a buscar en GESTORES -> Cuentas -> Usuario
USUARIO_BUSQUEDA=cib7kb9v3scb2sltq6yx6cf17
# Lista separada por comas (opcional; si esta vacia se usa USUARIO_BUSQUEDA)
USUARIOS=
MONTO_CREDITO=1

# false = se ve el navegador (recomendado mientras probamos)
HEADLESS=false
# false = llega hasta cargar el monto pero NO guarda (modo prueba)
GUARDAR=false
# Tope de seguridad (no es espera fija): solo corta si el servidor no responde nunca
TIMEOUT_MS=60000
# Si la busqueda de un usuario queda en 'loading' mas que esto, se registra y se sigue
TIMEOUT_BUSQUEDA_MS=3000
